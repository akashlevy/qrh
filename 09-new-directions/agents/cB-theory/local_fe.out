====================================================================================================
n=2 l=0: SINGLETON.  psi_l = (1 + b X^1) C_l,  |b| = q^0
   M = q^(l(1/2-u)) * [A(Y)/A(X)] * [D(X)/D(Y)]  with A,D Euler-type polynomials
   leading monomials of q^(l/2) X^l A(Y): [(-1, e0/sqrt(q)), (0, 1)]
n=2 l=1: SINGLETON.  psi_l = (1 + b X^2) C_l,  |b| = q^0
   M = q^(l(1/2-u)) * [A(Y)/A(X)] * [D(X)/D(Y)]  with A,D Euler-type polynomials
   leading monomials of q^(l/2) X^l A(Y): [(-1, -1/q), (1, 1)]
====================================================================================================
n=3 pair (l,l')=(0,1):  det A - D = 0
   T_0 <- T_0(1-u):  [e=0, weight 1],  [e=0, weight -1/q]
   T_0 <- T_1(1-u):  [e=-1, weight e0/sqrt(q)],  [e=2, weight -e0/sqrt(q)]
   T_1 <- T_0(1-u):  [e=-1, weight 1/(e0*sqrt(q))],  [e=2, weight -1/(e0*sqrt(q))]
   T_1 <- T_1(1-u):  [e=1, weight 1],  [e=1, weight -1/q]
n=3 pair (l,l')=(1,0):  det A - D = 0
   T_1 <- T_1(1-u):  [e=1, weight 1],  [e=1, weight -1/q]
   T_1 <- T_0(1-u):  [e=-1, weight e1/sqrt(q)],  [e=2, weight -e1/sqrt(q)]
   T_0 <- T_1(1-u):  [e=-1, weight 1/(e1*sqrt(q))],  [e=2, weight -1/(e1*sqrt(q))]
   T_0 <- T_0(1-u):  [e=0, weight 1],  [e=0, weight -1/q]
