   T_0 <- T_0(1-u):  [e=0, weight 1],  [e=0, weight -1/q]
   T_0 <- T_4(1-u):  [e=-1, weight e0/sqrt(q)],  [e=5, weight -e0/sqrt(q)]
   T_4 <- T_0(1-u):  [e=-1, weight 1/(e0*sqrt(q))],  [e=5, weight -1/(e0*sqrt(q))]
