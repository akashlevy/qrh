   T_3 <- T_3(1-u):  [e=3, weight 1],  [e=3, weight -1/q]
   T_3 <- T_1(1-u):  [e=-1, weight e3/sqrt(q)],  [e=5, weight -e3/sqrt(q)]
   T_1 <- T_3(1-u):  [e=-1, weight 1/(e3*sqrt(q))],  [e=5, weight -1/(e3*sqrt(q))]
